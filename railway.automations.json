{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "DOCKERFILE", "dockerfilePath": "Dockerfile" },
  "deploy": {
    "startCommand": "pnpm exec tsx -e \"import('./src/lib/automations').then((m) => m.enqueueAutomationsForAllUsers()).then(() => process.exit(0))\"",
    "cronSchedule": "0 9 * * *",
    "restartPolicyType": "NEVER"
  }
}
