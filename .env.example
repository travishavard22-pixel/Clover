# ─── Core ────────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Prisma + job queue + rate limiter)
DATABASE_URL="postgresql://clover:clover_dev@127.0.0.1:5432/clover_dev"
# Public origin of this deployment (used for OAuth redirect URIs and absolute links)
APP_URL="http://localhost:3000"
# 32+ random bytes, base64. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Versioned AES-256-GCM master keys for marketplace tokens: "v1:<base64 32 bytes>[,v0:<...>]"
# The first key encrypts; all keys can decrypt (rotation). Generate: openssl rand -base64 32
CLOVER_ENCRYPTION_KEYS=""
# Force Demo mode even if keys are present (useful for previews and e2e)
CLOVER_DEMO_MODE="0"

# ─── AI (Anthropic) ──────────────────────────────────────────────────────────
# Leave unset to run the AI layer in Demo mode.
ANTHROPIC_API_KEY=""
# Only for an organization-level key, which is not scoped to a workspace and is rejected with a
# 400 until the request names one. Keys created inside a workspace need this left empty.
ANTHROPIC_WORKSPACE_ID=""
CLOVER_MODEL_IDENTIFY="claude-opus-5"
CLOVER_MODEL_WRITE="claude-opus-5"
CLOVER_MODEL_CHECK="claude-haiku-4-5"
CLOVER_MODEL_COPILOT="claude-opus-5"

# ─── Storage ─────────────────────────────────────────────────────────────────
# local | s3
# --- Push notifications (phone and desktop apps) --------------------------------------------
# Android: a Firebase service account JSON (raw or base64). iOS: an APNs auth key (.p8) from the
# Apple Developer account. See docs/runbooks/native-apps.md.
FCM_SERVICE_ACCOUNT_JSON=""
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_PRIVATE_KEY=""
APNS_BUNDLE_ID="app.clover.mobile"
APNS_ENV="production"

STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ─── Photo studio providers ──────────────────────────────────────────────────
# none | photoroom | removebg | runpod
STUDIO_SEGMENTATION_PROVIDER="none"
PHOTOROOM_API_KEY=""
REMOVEBG_API_KEY=""
RUNPOD_API_KEY=""
RUNPOD_SEGMENT_ENDPOINT_ID=""

# ─── eBay ────────────────────────────────────────────────────────────────────
# Leave unset to run the eBay adapter in Demo mode.
EBAY_ENV="sandbox"            # sandbox | production
EBAY_CLIENT_ID=""             # App ID
EBAY_CLIENT_SECRET=""         # Cert ID
EBAY_RU_NAME=""               # Redirect URL name registered in the eBay developer console
EBAY_MARKETPLACE_ID="EBAY_US"
# Random token used to verify eBay's Marketplace Account Deletion challenge
EBAY_ACCOUNT_DELETION_VERIFICATION_TOKEN=""

# ─── Nextdoor (Publish API — closed beta) ────────────────────────────────────
NEXTDOOR_CLIENT_ID=""
NEXTDOOR_CLIENT_SECRET=""

# ─── Barcode lookup (optional) ───────────────────────────────────────────────
UPCITEMDB_USER_KEY=""

# --- Development only -----------------------------------------------------------------------
# CLOVER_INLINE_WORKER=0     # run jobs in a separate `pnpm worker` instead of inside the web process
# CLOVER_SEED_RESET=1        # `pnpm db:seed` rebuilds the demo account from scratch
# NEXT_DIST_DIR=.next-a      # separate build folder per dev server on one checkout
# E2E_PORT=3100              # port Playwright starts `next dev` on
# PLAYWRIGHT_CHROMIUM_PATH=  # path to a preinstalled Chromium for Playwright
# TEST_DATABASE_URL=         # integration tests use this database instead of DATABASE_URL
