{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clover",
  "version": "0.1.0",
  "identifier": "app.clover.desktop",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "Photograph it. It's for sale.",
    "longDescription": "Clover identifies what you are selling, prices it from real listings, writes the copy, cleans up the photos and publishes it across marketplaces.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "12.0" },
    "windows": { "wix": { "language": "en-US" } },
    "linux": { "deb": { "depends": [] } }
  }
}
